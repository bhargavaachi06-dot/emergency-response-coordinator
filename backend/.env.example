PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/emergency_response
DATABASE_SSL=false

# ============================================================
# AUTHENTICATION & JWT SECURITY
# Required in production
# ============================================================
JWT_SECRET=your_secure_random_jwt_secret_key_here

# ============================================================
# GOOGLE OAUTH 2.0 CLIENT CONFIGURATION
# Required for verifying Google ID Tokens on POST /api/auth/google
# Must match frontend VITE_GOOGLE_CLIENT_ID from Google Cloud Console
# ============================================================
GOOGLE_CLIENT_ID=
# Architecture Note: GOOGLE_CLIENT_SECRET and GOOGLE_REDIRECT_URI are intentionally
# omitted because the application uses Google Identity Services (GIS) ID-token flow.
# Token verification uses Google's public JWKS certificates and audience check,
# eliminating the need for server-side secret exposure or redirect callback endpoints.

# Frontend production URL (for dynamic CORS origin whitelist)
FRONTEND_URL=https://emergency-response-coordinator.vercel.app

# ============================================================
# EMAIL OTP CONFIGURATION (SMTP)
# Optional in dev (falls back to safe buffer stream logging)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Emergency Response Coordinator" <no-reply@emergencyresponse.org>

# ============================================================
# MOBILE OTP SMS GATEWAY (Twilio)
# Optional in dev; mobile OTPs are securely hashed & stored in PostgreSQL
# ============================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890

# ============================================================
# AI PROVIDER — Google Gemini
# Docs: https://aistudio.google.com/apikey
# ============================================================
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-flash-lite-latest

# ============================================================
# EPISODIC MEMORY — Vectorize Hindsight
# Docs: https://hindsight.vectorize.io/
# ============================================================
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=emergency-response-coordinator
