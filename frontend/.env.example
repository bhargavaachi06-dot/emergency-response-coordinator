# ============================================================
# Emergency Response Coordinator — Frontend Environment Config
# ============================================================

# Backend API Root URL (Render Production / Local)
VITE_API_BASE_URL=https://emergency-response-coordinator-api.onrender.com
VITE_API_URL=https://emergency-response-coordinator-api.onrender.com

# Google OAuth 2.0 Web Client ID (Google Identity Services)
# Required for Google Sign-In button and Google ID Token flow
# Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web application
# https://console.cloud.google.com/apis/credentials
# NOTE: Never put Google OAuth Client Secret in frontend code or VITE_* variables.
VITE_GOOGLE_CLIENT_ID=174399508894-kol6idj38qent0kh35ni7mtgi2ci22vk.apps.googleusercontent.com

# Primary Map Service: OpenStreetMap + Leaflet (Nominatim Reverse Geocoding)
# Zero API keys required! Production ready and works out of the box.

# Firebase Web Client Configuration (Optional legacy fallback for Google OAuth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
