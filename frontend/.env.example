# ============================================================
# Emergency Response Coordinator — Frontend Environment Config
# ============================================================
# Production Render backend API URL (Required on Vercel & Android):
VITE_API_URL=https://emergency-response-coordinator-api.onrender.com

# Local development backend API URL:
# VITE_API_URL=http://localhost:5000

# Optional Firebase Web Client Configuration (for Google OAuth & Phone OTP)
# Get these public identifiers from Firebase Console -> Project Settings
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
