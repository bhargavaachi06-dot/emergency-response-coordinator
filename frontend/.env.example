# ============================================================
# Emergency Response Coordinator — Frontend Environment Config
# ============================================================

# Backend API Root URL (Render Production / Local)
VITE_API_URL=https://emergency-response-coordinator-api.onrender.com

# Firebase Web Client Configuration (for Google OAuth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps JavaScript API Key
# Required APIs: Maps JavaScript API, Geocoding API
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=
